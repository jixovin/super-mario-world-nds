# The upstream checkout is a local reference only; keep its independent Git
# repository, generated output, and all source ROMs out of this project.
/reference/
/roms/
*.sfc
*.smc
*.fig

# Local NDS build products and emulator files.
/nds/build/
*.elf
*.nds
*.map
*.gba
*.sav
*.dsv


# Local secrets (never commit)
.github-token
*.token
/nds/*.nds
/nds/*.elf

# Game data made from your own ROM (never commit)
/nds/data/*.bin
smw_assets.dat
*.bundle
__pycache__/
/nds/ci-test/
/nds/data/assets_version.txt
